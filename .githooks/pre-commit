#!/usr/bin/env bash
# Enable once per clone: git config core.hooksPath .githooks
# Commits that only touch docs, tickets or markdown skip the cargo gates;
# CI and every merge still run the full check.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
if ! git diff --cached --name-only --diff-filter=ACMR \
    | grep -qvE '(\.md$|^\.scratch/|^docs/)'; then
    exec "$root/scripts/check-glossary-terms.sh" "$root"
fi
# At low CPU and IO priority, so the desktop stays usable while it runs.
quiet=(nice -n 10)
command -v ionice >/dev/null && quiet+=(ionice -c2 -n7)
exec "${quiet[@]}" "$root/scripts/check.sh"
