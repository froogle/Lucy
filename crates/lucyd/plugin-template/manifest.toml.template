name = "{{name}}"
version = "0.1.0"
author = "lucy"
# One line: what the Plugin is for, as Lucy would say it.
summary = "Says what this Plugin does"
command = ["./target/release/{{name}}"]

# One entry per tool the server lists, with the same name.
[[tools]]
name = "example"
# One line: the requests it handles, as the user would put them.
handles = "an example request"
examples = ["an example of what the user might say"]   # at most 3
confirm = false
# confirm_prompt = "Shall I do {thing}?"
# A read-only tool, with no [[tools]] entry of its own, that Lucy calls with
# the same arguments before asking, to show the user what they're saying yes
# to. It returns structuredContent {"items": ["<markdown>", ...]}.
# describe = "describe_example"

[access]
read = []          # paths it reads, such as "~/Pictures"
write = []         # paths it writes
network = []       # hosts it reaches
# Names of secrets it needs, passed as env vars, such as "PHOTOS_API_KEY".
# Listing its tools runs it without them: read them only in a tool call.
credentials = []
commands = []      # programs it runs, such as "xdg-open"
