[package]
name = "{{name}}"
version = "0.1.0"
edition = "2021"
publish = false

# The library is `plugin`; the executable is named after the package.
[lib]
name = "plugin"

# Built on its own, not as part of any other workspace.
[workspace]

[dependencies]
rmcp = { version = "3.10", default-features = false, features = ["server", "transport-io"] }
tokio = { version = "1", features = ["rt", "macros", "io-std"] }
serde_json = "1"

[dev-dependencies]
rmcp = { version = "3.10", default-features = false, features = ["client"] }
tokio = { version = "1", features = ["rt", "macros", "io-util"] }
tempfile = "3"
