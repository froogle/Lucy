{
  "$defs": {
    "ApprovalInfo": {
      "properties": {
        "hash": {
          "description": "The approved hash of its Manifest plus executable.",
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "previous_hash": {
          "description": "The previous approved hash, which it can be rolled back to with no\nnew Approval.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "plugin",
        "hash"
      ],
      "type": "object"
    },
    "ApprovalsList": {
      "description": "Result of `approvals.list`: every Approval Lucy holds.",
      "properties": {
        "approvals": {
          "description": "Sorted by Plugin name.",
          "items": {
            "$ref": "#/$defs/ApprovalInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "approvals"
      ],
      "type": "object"
    },
    "Hello": {
      "description": "Params of `hello`, the first request on every connection.",
      "properties": {
        "client": {
          "description": "Free-form client name, for logs.",
          "type": "string"
        },
        "protocol": {
          "description": "Major protocol version the client speaks.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A role the client claims, if any."
        }
      },
      "required": [
        "protocol",
        "client"
      ],
      "type": "object"
    },
    "HelloResult": {
      "description": "Result of `hello`.",
      "properties": {
        "protocol": {
          "description": "Major protocol version lucyd speaks.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "server": {
          "description": "lucyd's name and version.",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "server"
      ],
      "type": "object"
    },
    "LevelEvent": {
      "description": "Params of the `level` event: how loud Lucy's voice is right now.",
      "properties": {
        "rms": {
          "description": "RMS of the samples just played, from 0.0 (silent) to 1.0.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "rms"
      ],
      "type": "object"
    },
    "PluginAuthor": {
      "description": "Who wrote a Plugin. Lucy changes only her own.",
      "enum": [
        "lucy",
        "human"
      ],
      "type": "string"
    },
    "PluginInfo": {
      "properties": {
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginAuthor"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "description": "False once disabled. A disabled Plugin keeps its files and Approval.",
          "type": "boolean"
        },
        "name": {
          "description": "Its folder's name.",
          "type": "string"
        },
        "problem": {
          "description": "Why it is broken, when it is.",
          "type": [
            "string",
            "null"
          ]
        },
        "shipped": {
          "description": "Shipped with Lucy: it can be disabled but not removed.",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/PluginStatus"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "From its Manifest, if that can be read.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "shipped",
        "enabled",
        "status"
      ],
      "type": "object"
    },
    "PluginStatus": {
      "oneOf": [
        {
          "const": "approved",
          "description": "Its exact content is approved.",
          "type": "string"
        },
        {
          "const": "awaiting_approval",
          "description": "New or changed since its last Approval. Only the user's spoken yes\napproves it.",
          "type": "string"
        },
        {
          "const": "broken",
          "description": "It can't be used; `problem` says why.",
          "type": "string"
        }
      ]
    },
    "PluginsChanged": {
      "description": "Params of the `plugins.changed` event: something in `plugins.list` or\n`approvals.list` changed. Fetch them again to see what.",
      "type": "object"
    },
    "PluginsList": {
      "description": "Result of `plugins.list`: every installed Plugin, a user one overriding\na shipped one of the same name.",
      "properties": {
        "plugins": {
          "description": "Sorted by name.",
          "items": {
            "$ref": "#/$defs/PluginInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "plugins"
      ],
      "type": "object"
    },
    "ProviderCheck": {
      "description": "Params of `provider.check`.",
      "properties": {
        "name": {
          "description": "The `[providers.<name>]` name.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ProviderCheckResult": {
      "description": "Result of `provider.check`: a real \"Reply OK\" round trip through the\nProvider, with the subscription guard's checks on it.",
      "properties": {
        "problem": {
          "description": "What's wrong and how to fix it, or `None` if the check passed.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ProviderKind": {
      "description": "Which CLI a Thinking Provider drives.",
      "enum": [
        "claude",
        "codex"
      ],
      "type": "string"
    },
    "ProviderStatus": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProviderKind",
          "description": "The CLI it drives."
        },
        "model": {
          "description": "The model passed to the CLI; `None` means the CLI's default.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Its `[providers.<name>]` name.",
          "type": "string"
        },
        "problem": {
          "description": "What's wrong and how to fix it, or `None` if it is healthy.",
          "type": [
            "string",
            "null"
          ]
        },
        "tiers": {
          "description": "The Model tiers that use it.",
          "items": {
            "$ref": "#/$defs/Tier"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "kind",
        "tiers"
      ],
      "type": "object"
    },
    "ProvidersStatus": {
      "description": "Result of `providers.status`: each Thinking Provider in `config.toml`,\nwith health checks that make no model call.",
      "properties": {
        "providers": {
          "description": "Sorted by name.",
          "items": {
            "$ref": "#/$defs/ProviderStatus"
          },
          "type": "array"
        }
      },
      "required": [
        "providers"
      ],
      "type": "object"
    },
    "RevokeApproval": {
      "description": "Params of `approvals.revoke`. The Plugin's tools go at once, even\nmid-Session.",
      "properties": {
        "plugin": {
          "type": "string"
        }
      },
      "required": [
        "plugin"
      ],
      "type": "object"
    },
    "Role": {
      "oneOf": [
        {
          "const": "indicator",
          "description": "Draws the Indicator. While no client holds it, lucyd uses notifications.",
          "type": "string"
        }
      ]
    },
    "SessionStarted": {
      "description": "Result of `session.start`.",
      "properties": {
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "session_id"
      ],
      "type": "object"
    },
    "SetPluginEnabled": {
      "description": "Params of `plugins.set_enabled`.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "description": "The Plugin's name.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "enabled"
      ],
      "type": "object"
    },
    "State": {
      "description": "Lucy's Session state.",
      "oneOf": [
        {
          "const": "idle",
          "description": "No Session is open.",
          "type": "string"
        },
        {
          "const": "listening",
          "description": "A Session is open and waiting for the user to speak.",
          "type": "string"
        },
        {
          "const": "thinking",
          "description": "A Turn is in progress and nothing is playing.",
          "type": "string"
        },
        {
          "const": "speaking",
          "description": "Lucy's speech is queued or playing.",
          "type": "string"
        },
        {
          "const": "confirming",
          "description": "A tool call waits for the user's spoken yes.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Something went wrong. Transient: the next state follows straight after.",
          "type": "string"
        }
      ]
    },
    "Status": {
      "description": "Result of `status`: a snapshot of lucyd.",
      "properties": {
        "session_id": {
          "description": "The current Session, if one is open.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/State"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "Subscribe": {
      "description": "Params of `subscribe`.",
      "properties": {
        "topics": {
          "items": {
            "$ref": "#/$defs/Topic"
          },
          "type": "array"
        }
      },
      "required": [
        "topics"
      ],
      "type": "object"
    },
    "Tier": {
      "description": "A Model tier.",
      "enum": [
        "fast",
        "advanced"
      ],
      "type": "string"
    },
    "Topic": {
      "oneOf": [
        {
          "const": "state",
          "description": "`state` events. The current state is sent straight after subscribing.",
          "type": "string"
        },
        {
          "const": "level",
          "description": "`level` events, about 30 a second while Lucy is speaking.",
          "type": "string"
        },
        {
          "const": "plugins",
          "description": "`plugins.changed` events.",
          "type": "string"
        }
      ]
    },
    "VoicePreview": {
      "description": "Params of `test.voice_preview`: Lucy speaks `text` in her running voice\non the configured speaker, outside any Session, between the Start and\nClosing sounds. It replies once playback has finished. Refused while a\nSession is open or another Voice preview plays; a Session that opens\ncuts it short.",
      "properties": {
        "text": {
          "description": "The sentence to say. Not empty.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Newline-delimited JSON-RPC 2.0 on $XDG_RUNTIME_DIR/lucy/lucyd.sock. Send hello first. Within a major protocol version, fields are only ever added.",
  "title": "lucyd public IPC, protocol 1",
  "x-events": {
    "level": {
      "params": {
        "$ref": "#/$defs/LevelEvent"
      }
    },
    "plugins.changed": {
      "params": {
        "$ref": "#/$defs/PluginsChanged"
      }
    },
    "state": {
      "params": {
        "$ref": "#/$defs/Status"
      }
    }
  },
  "x-methods": {
    "approvals.list": {
      "result": {
        "$ref": "#/$defs/ApprovalsList"
      }
    },
    "approvals.revoke": {
      "params": {
        "$ref": "#/$defs/RevokeApproval"
      },
      "result": {
        "type": "object"
      }
    },
    "hello": {
      "params": {
        "$ref": "#/$defs/Hello"
      },
      "result": {
        "$ref": "#/$defs/HelloResult"
      }
    },
    "plugins.list": {
      "result": {
        "$ref": "#/$defs/PluginsList"
      }
    },
    "plugins.set_enabled": {
      "params": {
        "$ref": "#/$defs/SetPluginEnabled"
      },
      "result": {
        "type": "object"
      }
    },
    "provider.check": {
      "params": {
        "$ref": "#/$defs/ProviderCheck"
      },
      "result": {
        "$ref": "#/$defs/ProviderCheckResult"
      }
    },
    "providers.status": {
      "result": {
        "$ref": "#/$defs/ProvidersStatus"
      }
    },
    "session.end": {
      "result": {
        "type": "object"
      }
    },
    "session.start": {
      "result": {
        "$ref": "#/$defs/SessionStarted"
      }
    },
    "status": {
      "result": {
        "$ref": "#/$defs/Status"
      }
    },
    "subscribe": {
      "params": {
        "$ref": "#/$defs/Subscribe"
      },
      "result": {
        "type": "object"
      }
    },
    "test.voice_preview": {
      "params": {
        "$ref": "#/$defs/VoicePreview"
      },
      "result": {
        "type": "object"
      }
    }
  }
}
