{
  "$defs": {
    "ApprovalInfo": {
      "properties": {
        "hash": {
          "description": "The approved hash of its Manifest plus executable.",
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "previous_hash": {
          "description": "The previous approved hash, which it can be rolled back to with no\nnew Approval.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "plugin",
        "hash"
      ],
      "type": "object"
    },
    "ApprovalsList": {
      "description": "Result of `approvals.list`: every Approval Lucy holds.",
      "properties": {
        "approvals": {
          "description": "Sorted by Plugin name.",
          "items": {
            "$ref": "#/$defs/ApprovalInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "approvals"
      ],
      "type": "object"
    },
    "Choices": {
      "description": "The options of a choice field: at least one.",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "Field": {
      "description": "One box in the Input dialog.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "url",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "number",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "One of `choices`.",
          "properties": {
            "choices": {
              "$ref": "#/$defs/Choices"
            },
            "kind": {
              "const": "choice",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "choices"
          ],
          "type": "object"
        },
        {
          "description": "A password or key: hidden as it is typed.",
          "properties": {
            "kind": {
              "const": "secret",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "description": {
          "description": "What to type in it, if the question alone doesn't say.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Its key in `input.answer`'s `values`.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Hello": {
      "description": "Params of `hello`, the first request on every connection.",
      "properties": {
        "client": {
          "description": "Free-form client name, for logs.",
          "type": "string"
        },
        "protocol": {
          "description": "Major protocol version the client speaks.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A role the client claims, if any."
        }
      },
      "required": [
        "protocol",
        "client"
      ],
      "type": "object"
    },
    "HelloResult": {
      "description": "Result of `hello`.",
      "properties": {
        "protocol": {
          "description": "Major protocol version lucyd speaks.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "server": {
          "description": "lucyd's name and version.",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "server"
      ],
      "type": "object"
    },
    "InputAnswer": {
      "description": "Params of `input.answer`, from the `input` holder only: what the user\ntyped. It never goes out on the socket.",
      "properties": {
        "id": {
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Each field's value, by its name.",
          "type": "object"
        }
      },
      "required": [
        "id",
        "values"
      ],
      "type": "object"
    },
    "InputCancel": {
      "description": "Params of `input.cancel`: the user closed the Input dialog unanswered.\nOnly the `input` holder sends it.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "InputClose": {
      "description": "Params of the `input.close` event: take the Input dialog away, unanswered.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "InputOpen": {
      "description": "Params of the `input.open` event, sent to the `input` holder only.\n\nIt shows the Input dialog, the Details window, or both in one window. With `fields` and no `items` it is the Input dialog; with `items` and no\n`fields` it is a Details window beside a spoken question, which the user\nonly reads; with both, the items show above the fields.",
      "properties": {
        "fields": {
          "description": "The Input dialog's boxes; empty for a Details window alone.",
          "items": {
            "$ref": "#/$defs/Field"
          },
          "type": "array"
        },
        "id": {
          "description": "Names this window in `input.answer`, `input.cancel` and `input.close`.",
          "type": "string"
        },
        "items": {
          "description": "The Details window's items, each CommonMark, in order. Private: the\nuser's data, sent nowhere but here.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "message": {
          "description": "The question, written by the tool or Plugin that asks it.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "message"
      ],
      "type": "object"
    },
    "LevelEvent": {
      "description": "Params of the `level` event: how loud Lucy's voice is right now.",
      "properties": {
        "rms": {
          "description": "RMS of the samples just played, from 0.0 (silent) to 1.0.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "rms"
      ],
      "type": "object"
    },
    "MicLevel": {
      "description": "Result of `test.mic_level`. lucyd first switches to the microphone\n`config.toml` names now. Refused while a Session is open or another\nsetup test runs.",
      "properties": {
        "quiet": {
          "description": "`rms` is under the level Lucy wants, even after her +24 dB quiet-mic\nboost. Barge-in by speech may not work then. Silence is quiet too.",
          "type": "boolean"
        },
        "rms": {
          "description": "The loudest RMS the microphone heard since the last `test.mic_level`,\nfrom 0.0 (silent) to 1.0.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "rms",
        "quiet"
      ],
      "type": "object"
    },
    "PluginAuthor": {
      "description": "Who wrote a Plugin. Lucy changes only her own.",
      "enum": [
        "lucy",
        "human"
      ],
      "type": "string"
    },
    "PluginInfo": {
      "properties": {
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginAuthor"
            },
            {
              "type": "null"
            }
          ]
        },
        "credentials": {
          "default": [],
          "description": "The names of the credentials its Manifest declares, entered with\n`lucy credentials <name>`. Never their values.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "description": "False once disabled. A disabled Plugin keeps its files and Approval.",
          "type": "boolean"
        },
        "name": {
          "description": "Its folder's name.",
          "type": "string"
        },
        "problem": {
          "description": "Why it is broken, when it is.",
          "type": [
            "string",
            "null"
          ]
        },
        "shipped": {
          "description": "Shipped with Lucy: it can be disabled but not removed.",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/PluginStatus"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "From its Manifest, if that can be read.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "shipped",
        "enabled",
        "status"
      ],
      "type": "object"
    },
    "PluginStatus": {
      "oneOf": [
        {
          "const": "approved",
          "description": "Its exact content is approved.",
          "type": "string"
        },
        {
          "const": "awaiting_approval",
          "description": "New or changed since its last Approval. Only the user's spoken yes\napproves it.",
          "type": "string"
        },
        {
          "const": "broken",
          "description": "It can't be used; `problem` says why.",
          "type": "string"
        },
        {
          "const": "not_for_this_desktop",
          "description": "Its Manifest's `requires` isn't met here, so it is left out quietly.",
          "type": "string"
        }
      ]
    },
    "PluginsChanged": {
      "description": "Params of the `plugins.changed` event: something in `plugins.list` or\n`approvals.list` changed. Fetch them again to see what.",
      "type": "object"
    },
    "PluginsList": {
      "description": "Result of `plugins.list`: every installed Plugin. A user Plugin overrides\na shipped one of the same name.",
      "properties": {
        "plugins": {
          "description": "Sorted by name.",
          "items": {
            "$ref": "#/$defs/PluginInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "plugins"
      ],
      "type": "object"
    },
    "ProviderCheck": {
      "description": "Params of `provider.check`.",
      "properties": {
        "name": {
          "description": "The `[providers.<name>]` name.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ProviderCheckResult": {
      "description": "Result of `provider.check`: a real \"Reply OK\" round trip through the\nProvider. The subscription guard's checks run on it.",
      "properties": {
        "problem": {
          "description": "What's wrong and how to fix it, or `None` if the check passed.",
          "type": [
            "string",
            "null"
          ]
        },
        "program": {
          "default": null,
          "description": "The executable a Delegate of it runs, past any mise shim; `None` if not found.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ProviderKind": {
      "description": "Which CLI a Thinking Provider drives.",
      "enum": [
        "claude",
        "codex"
      ],
      "type": "string"
    },
    "ProviderStatus": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProviderKind",
          "description": "The CLI it drives."
        },
        "model": {
          "description": "The model passed to the CLI; `None` means the CLI's default.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Its `[providers.<name>]` name.",
          "type": "string"
        },
        "problem": {
          "description": "What's wrong and how to fix it, or `None` if it is healthy.",
          "type": [
            "string",
            "null"
          ]
        },
        "tiers": {
          "description": "The Model tiers that use it.",
          "items": {
            "$ref": "#/$defs/Tier"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "kind",
        "tiers"
      ],
      "type": "object"
    },
    "ProvidersStatus": {
      "description": "Result of `providers.status`: each Thinking Provider in `config.toml`.\nIts health checks make no model call.",
      "properties": {
        "providers": {
          "description": "Sorted by name.",
          "items": {
            "$ref": "#/$defs/ProviderStatus"
          },
          "type": "array"
        }
      },
      "required": [
        "providers"
      ],
      "type": "object"
    },
    "RevokeApproval": {
      "description": "Params of `approvals.revoke`. The Plugin's tools go at once, even\nmid-Session.",
      "properties": {
        "plugin": {
          "type": "string"
        }
      },
      "required": [
        "plugin"
      ],
      "type": "object"
    },
    "Role": {
      "oneOf": [
        {
          "const": "indicator",
          "description": "Draws the Indicator. While no client holds it, lucyd uses notifications.",
          "type": "string"
        },
        {
          "const": "input",
          "description": "Draws the Input dialog. One client holds it, the first to claim it;\nwhile none does, lucyd opens `lucy input` in a terminal.",
          "type": "string"
        }
      ]
    },
    "SessionStarted": {
      "description": "Result of `session.start`.",
      "properties": {
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "session_id"
      ],
      "type": "object"
    },
    "SetPluginEnabled": {
      "description": "Params of `plugins.set_enabled`.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "description": "The Plugin's name.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "enabled"
      ],
      "type": "object"
    },
    "State": {
      "description": "Lucy's Session state.",
      "oneOf": [
        {
          "const": "idle",
          "description": "No Session is open.",
          "type": "string"
        },
        {
          "const": "listening",
          "description": "A Session is open and waiting for the user to speak.",
          "type": "string"
        },
        {
          "const": "thinking",
          "description": "A Turn is in progress and nothing is playing.",
          "type": "string"
        },
        {
          "const": "speaking",
          "description": "Lucy's speech is queued or playing.",
          "type": "string"
        },
        {
          "const": "confirming",
          "description": "A tool call waits for the user's spoken yes.",
          "type": "string"
        },
        {
          "const": "typing",
          "description": "The Input dialog is open: Lucy waits for the user to type.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Something went wrong. Transient: the next state follows straight after.",
          "type": "string"
        }
      ]
    },
    "Status": {
      "description": "Result of `status`: a snapshot of lucyd.",
      "properties": {
        "building": {
          "default": false,
          "description": "An Authoring build is running, with or without a Session. The\nIndicator adds a \"building\" mark.",
          "type": "boolean"
        },
        "looking": {
          "default": false,
          "description": "A screen tool is capturing the screen for the model. The Indicator\nadds a \"looking\" mark.",
          "type": "boolean"
        },
        "session_id": {
          "description": "The current Session, if one is open.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/State"
        },
        "working": {
          "default": false,
          "description": "A Hand-off is running, with or without a Session. The Indicator adds\na \"working\" mark.",
          "type": "boolean"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "Subscribe": {
      "description": "Params of `subscribe`.",
      "properties": {
        "topics": {
          "items": {
            "$ref": "#/$defs/Topic"
          },
          "type": "array"
        }
      },
      "required": [
        "topics"
      ],
      "type": "object"
    },
    "Tier": {
      "description": "A Model tier.",
      "enum": [
        "fast",
        "advanced"
      ],
      "type": "string"
    },
    "Topic": {
      "oneOf": [
        {
          "const": "state",
          "description": "`state` events. The current state is sent straight after subscribing.",
          "type": "string"
        },
        {
          "const": "level",
          "description": "`level` events, about 30 a second while Lucy is speaking.",
          "type": "string"
        },
        {
          "const": "plugins",
          "description": "`plugins.changed` events.",
          "type": "string"
        }
      ]
    },
    "TtsKind": {
      "description": "A TTS Provider, as `[tts] kind` names it.",
      "enum": [
        "piper",
        "kokoro"
      ],
      "type": "string"
    },
    "Voice": {
      "description": "A voice of one TTS Provider.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/TtsKind"
        },
        "name": {
          "description": "The voice's name in that Provider, such as `en_GB-cori-medium` in\nPiper or `bf_emma` in Kokoro.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    },
    "VoicePreview": {
      "description": "Params of `test.voice_preview`: Lucy speaks `text` outside any Session.\nShe uses her configured voice on the configured speaker, between the Start\nand Closing sounds. It replies once playback has finished. Refused while a\nSession is open or another Voice preview plays; a Session that opens\ncuts it short.",
      "properties": {
        "text": {
          "description": "The sentence to say. Not empty.",
          "type": "string"
        },
        "voice": {
          "anyOf": [
            {
              "$ref": "#/$defs/Voice"
            },
            {
              "type": "null"
            }
          ],
          "description": "The voice to say it in. Unset means the configured one. lucyd\nfetches it first if it must."
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "WakeWordTest": {
      "description": "Params of `test.wake_word`: lucyd listens for the Wake word outside any\nSession. It replies once it is heard or `timeout_secs` have passed.\nHearing it opens no Session. Refused while a Session is open.",
      "properties": {
        "timeout_secs": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "timeout_secs"
      ],
      "type": "object"
    },
    "WakeWordTestResult": {
      "description": "Result of `test.wake_word`.",
      "properties": {
        "heard": {
          "description": "Whether the Wake word was heard.",
          "type": "boolean"
        },
        "score": {
          "description": "The best score the wake-word engine gave, from 0 to 1. `[wake_word]\nthreshold` is where it counts as heard.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "heard",
        "score"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Newline-delimited JSON-RPC 2.0 on $XDG_RUNTIME_DIR/lucy/lucyd.sock. Send hello first. Within a major protocol version, fields are only ever added.",
  "title": "lucyd public IPC, protocol 1",
  "x-events": {
    "input.close": {
      "params": {
        "$ref": "#/$defs/InputClose"
      }
    },
    "input.open": {
      "params": {
        "$ref": "#/$defs/InputOpen"
      }
    },
    "level": {
      "params": {
        "$ref": "#/$defs/LevelEvent"
      }
    },
    "plugins.changed": {
      "params": {
        "$ref": "#/$defs/PluginsChanged"
      }
    },
    "state": {
      "params": {
        "$ref": "#/$defs/Status"
      }
    }
  },
  "x-methods": {
    "approvals.list": {
      "result": {
        "$ref": "#/$defs/ApprovalsList"
      }
    },
    "approvals.revoke": {
      "params": {
        "$ref": "#/$defs/RevokeApproval"
      },
      "result": {
        "type": "object"
      }
    },
    "hello": {
      "params": {
        "$ref": "#/$defs/Hello"
      },
      "result": {
        "$ref": "#/$defs/HelloResult"
      }
    },
    "input.answer": {
      "params": {
        "$ref": "#/$defs/InputAnswer"
      },
      "result": {
        "type": "object"
      }
    },
    "input.cancel": {
      "params": {
        "$ref": "#/$defs/InputCancel"
      },
      "result": {
        "type": "object"
      }
    },
    "plugins.list": {
      "result": {
        "$ref": "#/$defs/PluginsList"
      }
    },
    "plugins.set_enabled": {
      "params": {
        "$ref": "#/$defs/SetPluginEnabled"
      },
      "result": {
        "type": "object"
      }
    },
    "provider.check": {
      "params": {
        "$ref": "#/$defs/ProviderCheck"
      },
      "result": {
        "$ref": "#/$defs/ProviderCheckResult"
      }
    },
    "providers.status": {
      "result": {
        "$ref": "#/$defs/ProvidersStatus"
      }
    },
    "session.end": {
      "result": {
        "type": "object"
      }
    },
    "session.start": {
      "result": {
        "$ref": "#/$defs/SessionStarted"
      }
    },
    "status": {
      "result": {
        "$ref": "#/$defs/Status"
      }
    },
    "subscribe": {
      "params": {
        "$ref": "#/$defs/Subscribe"
      },
      "result": {
        "type": "object"
      }
    },
    "test.mic_level": {
      "result": {
        "$ref": "#/$defs/MicLevel"
      }
    },
    "test.voice_preview": {
      "params": {
        "$ref": "#/$defs/VoicePreview"
      },
      "result": {
        "type": "object"
      }
    },
    "test.wake_word": {
      "params": {
        "$ref": "#/$defs/WakeWordTest"
      },
      "result": {
        "$ref": "#/$defs/WakeWordTestResult"
      }
    }
  }
}
